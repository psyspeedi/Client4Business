# ─────────────────────────────────────────────────────────────────────────────
# OpenClaw + Telegram. Скопируйте в .env и заполните.
#   make init — сделает копию и сгенерирует токен Gateway
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Telegram ──────────────────────────────────────────────────────────────
# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=

# Ваш numeric Telegram user ID (@userinfobot). Нужен для allowlist и для того,
# чтобы служебные команды остались только у вас.
TELEGRAM_OWNER_ID=

# Кому бот отвечает в личных сообщениях:
#   allowlist — только TELEGRAM_OWNER_ID (по умолчанию)
#   open      — любому, кто напишет (на время внешней проверки)
#   pairing   — первый диалог подтверждается через `make pair`
TELEGRAM_DM_POLICY=allowlist

# ── 2. Модель ────────────────────────────────────────────────────────────────
# Ключ с openrouter.ai/keys. Поставьте на него лимит кредита — бот с
# TELEGRAM_DM_POLICY=open доступен всем, кто знает его @username.
OPENROUTER_API_KEY=

# Полное имя с провайдером или короткое (тогда добавится openrouter/).
#   openrouter/auto                          — автовыбор
#   openrouter/deepseek/deepseek-chat-v3.1
#   openrouter/anthropic/claude-sonnet-4.5
LLM_MODEL=openrouter/auto

# ── 3. Реле (см. relay/ и README §3) ─────────────────────────────────────────
# Reverse proxy на сервере, у которого есть доступ к api.telegram.org и
# openrouter.ai. Машине со стендом ни VPN, ни туннель не нужны — она ходит
# на эти адреса обычным HTTPS.
#
# Заполняется одной командой, она же соберёт конфиги для сервера:
#   make relay-host HOST=relay.example.com PORT=8444
#
# Оставьте пустыми, если api.telegram.org и openrouter.ai открываются с вашей
# машины напрямую — стек в этом случае работает без изменений.
TELEGRAM_API_ROOT=
OPENROUTER_BASE_URL=

# ── 4. Запасной путь: обычный HTTP-прокси ────────────────────────────────────
# Альтернатива реле, если он у вас уже есть. Пустые значения игнорируются.
#   HTTPS_PROXY=http://user:pass@proxy.example.com:8080
HTTP_PROXY=
HTTPS_PROXY=

# ── 5. Безопасность ──────────────────────────────────────────────────────────
# Профиль инструментов агента:
#   minimal — без доступа к shell и файлам (по умолчанию; обязателен, если
#             бот открыт посторонним: иначе агента можно попросить показать
#             собственное окружение вместе с токенами)
#   coding  — полный набор инструментов, только для закрытого бота
TOOLS_PROFILE=minimal

# ── 6. Gateway ───────────────────────────────────────────────────────────────
# Токен доступа к Control UI. Сгенерировать: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
# Порт Control UI. Публикуется только на 127.0.0.1 хоста.
OPENCLAW_GATEWAY_PORT=18789

# ── 7. Образ ─────────────────────────────────────────────────────────────────
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

TZ=Europe/Moscow
